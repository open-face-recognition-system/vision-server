APP_SECRET=change-me
# Public URL of the API, used in photo links. Behind vision-web it is the web URL plus /api
APP_URL=http://localhost:8080/api

DB_HOST=localhost
DB_PORT=5432
DB_USER=vision
DB_PASS=vision
DB_NAME=vision

# Created on boot when the email is unknown
ADMIN_EMAIL=admin@vision.local
ADMIN_PASSWORD=change-me

# eigenfaces | fisherfaces | lbph
RECOGNITION_ALGORITHM=lbph
# Maximum distance accepted as a match; defaults per algorithm
# RECOGNITION_THRESHOLD=70
