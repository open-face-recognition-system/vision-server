{
  "name": "vision-server",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "author": "Mario Fronza <mariofronza1@gmail.com>",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file=.env src/shared/infra/http/server.ts",
    "start": "node dist/shared/infra/http/server.js",
    "migration:run": "typeorm migration:run -d dist/shared/infra/typeorm/dataSource.js",
    "migration:revert": "typeorm migration:revert -d dist/shared/infra/typeorm/dataSource.js",
    "seed": "node dist/shared/infra/typeorm/seed.js",
    "test": "jest",
    "format": "prettier --write src"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "celebrate": "^16.0.0",
    "class-transformer": "^0.5.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pdf2json": "^4.1.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5"
  }
}
